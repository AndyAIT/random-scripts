<#
.SYNOPSIS
    Gorelo OneDrive Process Remediation

.DESCRIPTION
    This remediation is designed to run as LocalSystem from Gorelo.
    It checks for an active interactive Windows user and starts OneDrive.exe using that user's Windows security token.
    If no interactive user is logged on, the script performs no action and exits successfully.

.VERSION
    2.0

.AUTHOR
    Andrew Egan

.CHANGELOG
    Version 2.0
    - Starts OneDrive in the logged-on user's interactive session.
    - Uses WTSQueryUserToken, DuplicateTokenEx, CreateEnvironmentBlock and CreateProcessAsUser.
    - Does nothing when no interactive user is logged on.
    - Writes remediation progress and results to the PowerShell output stream for capture by Gorelo.
    - Supports machine-wide and per-user OneDrive installations.
    - Confirms OneDrive is running in the correct interactive session.

.ACKNOWLEDGEMENTS
    The user-session process-launch method was developed with reference to https://www.cyberdrain.com/monitoring-with-powershell-monitoring-onedrive-known-folder-move/

.NOTES
    Intended execution context: LocalSystem

    Exit codes:
        0 = No remediation required, no user logged on, or successful
        1 = Remediation failed
#>

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

$ErrorActionPreference = "Stop"

$ValidationDelaySeconds = 8
$InvalidSessionId = [uint32]::MaxValue

# ---------------------------------------------------------------------------
# Start remediation output
# ---------------------------------------------------------------------------

Write-Output "REMEDIATION: OneDrive was detected as not running. Remediation has started."

# ---------------------------------------------------------------------------
# Native Windows user-session process launcher
# ---------------------------------------------------------------------------

$ProcessLauncherSource = @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
using System.Text;

namespace Gorelo.OneDriveRemediation.V2
{
    public static class UserSessionProcess
    {
        private const uint INVALID_SESSION_ID = 0xFFFFFFFF;
        private const uint CREATE_UNICODE_ENVIRONMENT = 0x00000400;
        private const uint CREATE_NO_WINDOW = 0x08000000;
        private const uint MAXIMUM_ALLOWED = 0x02000000;

        private const int SECURITY_IMPERSONATION = 2;
        private const int TOKEN_PRIMARY = 1;

        private static readonly IntPtr WTS_CURRENT_SERVER_HANDLE =
            IntPtr.Zero;

        private enum WTS_CONNECTSTATE_CLASS
        {
            WTSActive,
            WTSConnected,
            WTSConnectQuery,
            WTSShadow,
            WTSDisconnected,
            WTSIdle,
            WTSListen,
            WTSReset,
            WTSDown,
            WTSInit
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct WTS_SESSION_INFO
        {
            public uint SessionID;
            public IntPtr pWinStationName;
            public WTS_CONNECTSTATE_CLASS State;
        }

        [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
        private struct STARTUPINFO
        {
            public int cb;
            public string lpReserved;
            public string lpDesktop;
            public string lpTitle;
            public uint dwX;
            public uint dwY;
            public uint dwXSize;
            public uint dwYSize;
            public uint dwXCountChars;
            public uint dwYCountChars;
            public uint dwFillAttribute;
            public uint dwFlags;
            public short wShowWindow;
            public short cbReserved2;
            public IntPtr lpReserved2;
            public IntPtr hStdInput;
            public IntPtr hStdOutput;
            public IntPtr hStdError;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct PROCESS_INFORMATION
        {
            public IntPtr hProcess;
            public IntPtr hThread;
            public uint dwProcessId;
            public uint dwThreadId;
        }

        [DllImport(
            "wtsapi32.dll",
            SetLastError = true
        )]
        private static extern bool WTSEnumerateSessions(
            IntPtr hServer,
            int reserved,
            int version,
            out IntPtr ppSessionInfo,
            out int pCount
        );

        [DllImport(
            "wtsapi32.dll"
        )]
        private static extern void WTSFreeMemory(
            IntPtr memory
        );

        [DllImport(
            "wtsapi32.dll",
            SetLastError = true
        )]
        private static extern bool WTSQueryUserToken(
            uint sessionId,
            out IntPtr token
        );

        [DllImport(
            "advapi32.dll",
            SetLastError = true
        )]
        private static extern bool DuplicateTokenEx(
            IntPtr existingToken,
            uint desiredAccess,
            IntPtr tokenAttributes,
            int impersonationLevel,
            int tokenType,
            out IntPtr newToken
        );

        [DllImport(
            "userenv.dll",
            SetLastError = true
        )]
        private static extern bool CreateEnvironmentBlock(
            out IntPtr environment,
            IntPtr token,
            bool inherit
        );

        [DllImport(
            "userenv.dll",
            SetLastError = true
        )]
        private static extern bool DestroyEnvironmentBlock(
            IntPtr environment
        );

        [DllImport(
            "advapi32.dll",
            SetLastError = true,
            CharSet = CharSet.Unicode
        )]
        private static extern bool CreateProcessAsUser(
            IntPtr token,
            string applicationName,
            StringBuilder commandLine,
            IntPtr processAttributes,
            IntPtr threadAttributes,
            bool inheritHandles,
            uint creationFlags,
            IntPtr environment,
            string currentDirectory,
            ref STARTUPINFO startupInfo,
            out PROCESS_INFORMATION processInformation
        );

        [DllImport(
            "kernel32.dll",
            SetLastError = true
        )]
        private static extern bool CloseHandle(
            IntPtr handle
        );

        public static uint GetActiveSessionId()
        {
            IntPtr sessionBuffer = IntPtr.Zero;
            int sessionCount = 0;

            try
            {
                bool enumerated = WTSEnumerateSessions(
                    WTS_CURRENT_SERVER_HANDLE,
                    0,
                    1,
                    out sessionBuffer,
                    out sessionCount
                );

                if (!enumerated)
                {
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "WTSEnumerateSessions failed."
                    );
                }

                int structureSize =
                    Marshal.SizeOf(typeof(WTS_SESSION_INFO));

                IntPtr currentSession = sessionBuffer;

                for (int index = 0; index < sessionCount; index++)
                {
                    WTS_SESSION_INFO session =
                        (WTS_SESSION_INFO)Marshal.PtrToStructure(
                            currentSession,
                            typeof(WTS_SESSION_INFO)
                        );

                    if (session.State ==
                        WTS_CONNECTSTATE_CLASS.WTSActive)
                    {
                        return session.SessionID;
                    }

                    currentSession = IntPtr.Add(
                        currentSession,
                        structureSize
                    );
                }

                return INVALID_SESSION_ID;
            }
            finally
            {
                if (sessionBuffer != IntPtr.Zero)
                {
                    WTSFreeMemory(sessionBuffer);
                }
            }
        }

        public static uint StartProcessAsActiveUser(
            string applicationPath,
            string arguments,
            string workingDirectory
        )
        {
            uint sessionId = GetActiveSessionId();

            if (sessionId == INVALID_SESSION_ID)
            {
                throw new InvalidOperationException(
                    "No active interactive Windows session was found."
                );
            }

            IntPtr impersonationToken = IntPtr.Zero;
            IntPtr primaryToken = IntPtr.Zero;
            IntPtr environment = IntPtr.Zero;

            PROCESS_INFORMATION processInformation =
                new PROCESS_INFORMATION();

            try
            {
                if (!WTSQueryUserToken(
                    sessionId,
                    out impersonationToken))
                {
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "WTSQueryUserToken failed."
                    );
                }

                if (!DuplicateTokenEx(
                    impersonationToken,
                    MAXIMUM_ALLOWED,
                    IntPtr.Zero,
                    SECURITY_IMPERSONATION,
                    TOKEN_PRIMARY,
                    out primaryToken))
                {
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "DuplicateTokenEx failed."
                    );
                }

                if (!CreateEnvironmentBlock(
                    out environment,
                    primaryToken,
                    false))
                {
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "CreateEnvironmentBlock failed."
                    );
                }

                STARTUPINFO startupInfo = new STARTUPINFO();

                startupInfo.cb =
                    Marshal.SizeOf(typeof(STARTUPINFO));

                startupInfo.lpDesktop = @"winsta0\default";

                string commandText =
                    "\"" + applicationPath + "\"";

                if (!String.IsNullOrWhiteSpace(arguments))
                {
                    commandText += " " + arguments;
                }

                StringBuilder commandLine =
                    new StringBuilder(commandText);

                bool processCreated = CreateProcessAsUser(
                    primaryToken,
                    applicationPath,
                    commandLine,
                    IntPtr.Zero,
                    IntPtr.Zero,
                    false,
                    CREATE_UNICODE_ENVIRONMENT | CREATE_NO_WINDOW,
                    environment,
                    workingDirectory,
                    ref startupInfo,
                    out processInformation
                );

                if (!processCreated)
                {
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "CreateProcessAsUser failed."
                    );
                }

                return processInformation.dwProcessId;
            }
            finally
            {
                if (processInformation.hThread != IntPtr.Zero)
                {
                    CloseHandle(processInformation.hThread);
                }

                if (processInformation.hProcess != IntPtr.Zero)
                {
                    CloseHandle(processInformation.hProcess);
                }

                if (environment != IntPtr.Zero)
                {
                    DestroyEnvironmentBlock(environment);
                }

                if (primaryToken != IntPtr.Zero)
                {
                    CloseHandle(primaryToken);
                }

                if (impersonationToken != IntPtr.Zero)
                {
                    CloseHandle(impersonationToken);
                }
            }
        }
    }
}
'@

# ---------------------------------------------------------------------------
# Load the C# helper
# ---------------------------------------------------------------------------

try {
    $LauncherTypeName =
        "Gorelo.OneDriveRemediation.V2.UserSessionProcess"

    if (-not ($LauncherTypeName -as [type])) {
        Add-Type `
            -TypeDefinition $ProcessLauncherSource `
            -Language CSharp `
            -ErrorAction Stop
    }
}
catch {
    Write-Output "ERROR: Unable to load the interactive user process launcher."
    Write-Output "ERROR DETAIL: $($_.Exception.Message)"
    exit 1
}

# ---------------------------------------------------------------------------
# Find the active interactive session
# ---------------------------------------------------------------------------

try {
    $ActiveSessionId =
        [Gorelo.OneDriveRemediation.V2.UserSessionProcess]::
            GetActiveSessionId()
}
catch {
    Write-Output "ERROR: Unable to enumerate Windows user sessions."
    Write-Output "ERROR DETAIL: $($_.Exception.Message)"
    exit 1
}

if ($ActiveSessionId -eq $InvalidSessionId) {
    Write-Output "INFO: No interactive user is logged on. No action will be taken."
    exit 0
}

# ---------------------------------------------------------------------------
# Find the interactive user from Explorer
# ---------------------------------------------------------------------------

try {
    $ExplorerProcess = Get-CimInstance `
        -ClassName Win32_Process `
        -Filter "Name = 'explorer.exe'" `
        -ErrorAction Stop |
        Where-Object {
            $_.SessionId -eq $ActiveSessionId
        } |
        Select-Object -First 1
}
catch {
    Write-Output "ERROR: Unable to query Explorer processes."
    Write-Output "ERROR$($_.Exception.Message)"
    exit 1
}

if ($null -eq $ExplorerProcess) {
    Write-Output "INFO: Session $ActiveSessionId is active, but no interactive user shell was found."
    Write-Output "INFO: No action will be taken."
    exit 0
}

try {
    $OwnerResult = Invoke-CimMethod `
        -InputObject $ExplorerProcess `
        -MethodName GetOwner `
        -ErrorAction Stop

    $OwnerSidResult = Invoke-CimMethod `
        -InputObject $ExplorerProcess `
        -MethodName GetOwnerSid `
        -ErrorAction Stop
}
catch {
    Write-Output "ERROR: Unable to identify the user associated with session $ActiveSessionId."
    Write-Output "ERROR DETAIL: $($_.Exception.Message)"
    exit 1
}

if (
    $OwnerResult.ReturnValue -ne 0 -or [string]::IsNullOrWhiteSpace($OwnerResult.User)
) {
    Write-Output "INFO: An interactive session was found, but its user could not be identified."
    Write-Output "INFO: No action will be taken."
    exit 0
}

if ([string]::IsNullOrWhiteSpace($OwnerResult.Domain)) {
    $LoggedOnUser = $OwnerResult.User
}
else {
    $LoggedOnUser =
        "$($OwnerResult.Domain)\$($OwnerResult.User)"
}

$LoggedOnUserSid = $OwnerSidResult.Sid

Write-Output "INFO: Interactive session found. Session ID: $ActiveSessionId"
Write-Output "INFO: Interactive user found: $LoggedOnUser"

# ---------------------------------------------------------------------------
# Confirm OneDrive is not already running in that session
# ---------------------------------------------------------------------------

$ExistingOneDrive = @(
    Get-Process `
        -Name "OneDrive" `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.SessionId -eq $ActiveSessionId
        }
)

if ($ExistingOneDrive.Count -gt 0) {
    $ExistingProcessIds = $ExistingOneDrive.Id -join ", "

    Write-Output "INFO: OneDrive is already running for $LoggedOnUser."
    Write-Output "INFO: Session ID: $ActiveSessionId. Process ID(s): $ExistingProcessIds"
    exit 0
}

# ---------------------------------------------------------------------------
# Locate OneDrive.exe
# ---------------------------------------------------------------------------

$OneDriveExecutable = $null

$OneDriveCandidatePaths = @(
    "$env:ProgramFiles\Microsoft OneDrive\OneDrive.exe"
)

if (-not [string]::IsNullOrWhiteSpace(${env:ProgramFiles(x86)})) {
    $OneDriveCandidatePaths +=
        "${env:ProgramFiles(x86)}\Microsoft OneDrive\OneDrive.exe"
}

foreach ($CandidatePath in $OneDriveCandidatePaths) {
    if (
        -not [String]::IsNullOrWhiteSpace($CandidatePath) -and
        (Test-Path -LiteralPath $CandidatePath)
    ) {
        $OneDriveExecutable = $CandidatePath
        break
    }
}

# Check the user's local profile if no machine-wide installation was found.
if (
    [string]::IsNullOrWhiteSpace($OneDriveExecutable) -and
    -not [string]::IsNullOrWhiteSpace($LoggedOnUserSid)
) {
    try {
        $UserProfile = Get-CimInstance `
            -ClassName Win32_UserProfile `
            -ErrorAction Stop |
            Where-Object {
                $_.SID -eq $LoggedOnUserSid
            } |
            Select-Object -First 1
    }
    catch {
        Write-Output "ERROR: Unable to query the local profile for $LoggedOnUser."
        Write-Output "ERROR DETAIL: $($_.Exception.Message)"
        exit 1
    }

    if (
        $null -ne $UserProfile -and
        -not [string]::IsNullOrWhiteSpace($UserProfile.LocalPath)
    ) {
        $PerUserOneDrivePath = Join-Path `
            -Path $UserProfile.LocalPath `
            -ChildPath "AppData\Local\Microsoft\OneDrive\OneDrive.exe"

        if (Test-Path -LiteralPath $PerUserOneDrivePath) {
            $OneDriveExecutable = $PerUserOneDrivePath
        }
    }
}

if ([string]::IsNullOrWhiteSpace($OneDriveExecutable)) {
    Write-Output "ERROR: OneDrive.exe could not be found."
    Write-Output "ERROR: Checked the machine-wide and $LoggedOnUser per-user installation paths."
    exit 1
}

$OneDriveWorkingDirectory = Split-Path `
    -Path $OneDriveExecutable `
    -Parent

# ---------------------------------------------------------------------------
# Start OneDrive as the interactive user
# ---------------------------------------------------------------------------

Write-Output "ACTION: Attempting to start OneDrive as $LoggedOnUser."
Write-Output "ACTION: OneDrive path: $OneDriveExecutable"

try {
    $RequestedProcessId =
        [Gorelo.OneDriveRemediation.V2.UserSessionProcess]::
            StartProcessAsActiveUser(
                $OneDriveExecutable,
                "/background",
                $OneDriveWorkingDirectory
            )

    Write-Output "ACTION: OneDrive launch request was submitted for $LoggedOnUser."
    Write-Output "ACTION: Initial process ID returned: $RequestedProcessId"
}
catch {
    Write-Output "ERROR: Failed to start OneDrive as $LoggedOnUser."
    Write-Output "ERROR DETAIL: $($_.Exception.Message)"
    exit 1
}

# ---------------------------------------------------------------------------
# Confirm OneDrive started in the correct session
# ---------------------------------------------------------------------------

Start-Sleep -Seconds $ValidationDelaySeconds

$StartedOneDrive = @(
    Get-Process `
        -Name "OneDrive" `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.SessionId -eq $ActiveSessionId
        }
)

if ($StartedOneDrive.Count -gt 0) {
    $StartedProcessIds = $StartedOneDrive.Id -join ", "

    Write-Output "SUCCESS: OneDrive started successfully as $LoggedOnUser."
    Write-Output "SUCCESS: OneDrive is running in interactive session $ActiveSessionId."
    Write-Output "SUCCESS: OneDrive process ID(s): $StartedProcessIds"
    exit 0
}

Write-Output "ERROR: OneDrive launch was attempted for $LoggedOnUser, but it was not detected after $ValidationDelaySeconds seconds."
Write-Output "ERROR: Expected OneDrive to be running in interactive session $ActiveSessionId."
exit 1
